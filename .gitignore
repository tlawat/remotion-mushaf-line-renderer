node_modules/
dist/
out/
.cache/
*.log
.DS_Store
coverage/
test-results/
playwright-report/
.remotion/

# No font file is committed. The two fonts packages (packages/fonts-<set>/, published on npm) fill
# their fonts/ folders from the local mirror or from QUL's CDN (`bun run fonts-packages:fill`) and
# check them against the committed manifest.json; the example's mirror (`bun run qul fonts`,
# `bun run qul mirror`) and the test fixtures are downloads too.
packages/fonts-*/fonts/
*.ttf
*.woff
*.woff2

# example/public/data/ holds the mirror of QUL's two data exports (open data, about 1.2 MB), written
# by `bun run qul data` and committed: the suites, CI and offline renders read it,
# the npm package does not (it fetches the same exports from Tarteel's CDN at render time).

# Stills written by the render suite for visual comparison.
packages/remotion-mushaf-line-renderer/test/render/*.png

# Recitation audio for the example is the reciter's; keep it out of the repository.
example/public/audio/*.mp3
example/public/audio/*.m4a
example/public/audio/*.wav

# Python bytecode from the example tools
__pycache__/
