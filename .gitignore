node_modules/
dist/
out/
.cache/
*.log
.DS_Store
coverage/
test-results/
playwright-report/

# QUL fonts are fetched by scripts/fetch-qul.mjs (or the "QUL assets" workflow) and are not
# redistributed. During development only, the fixture pages 1, 10, 187 and 604 are committed so the
# browser and render suites run without network access. Before the public release delete the ten
# negation lines below and run:
#   git rm -r --cached example/public/fonts packages/remotion-mushaf-line-renderer/test/fixtures/fonts
# (CI downloads the fixture font itself when it is missing; the npm package never contains fonts.)
**/public/fonts/**/*.ttf
**/public/fonts/**/*.woff
**/public/fonts/**/*.woff2
**/test/fixtures/fonts/**/*.ttf
**/test/fixtures/fonts/**/*.woff
**/test/fixtures/fonts/**/*.woff2
!**/public/fonts/**/p1.*
!**/public/fonts/**/p10.*
!**/public/fonts/**/p187.*
!**/public/fonts/**/p604.*
!**/test/fixtures/fonts/**/p1.*
!**/test/fixtures/fonts/**/p10.*
!**/test/fixtures/fonts/**/p187.*
!**/test/fixtures/fonts/**/p604.*
# Development only as well: the example's mirror of every page's woff2 (and the woff the CDN serves
# where it has no woff2), pulled by scripts/pull-all-assets.sh so the Studio and the Recitation
# composition work offline for any page. About 95 MB for both sets. Delete these two lines before
# the public release too (same git rm as above).
!example/public/fonts/**/*.woff2
!example/public/fonts/**/*.woff

# Stills written by the render suite for visual comparison.
packages/remotion-mushaf-line-renderer/test/render/*.png

# Recitation audio for the example is the reciter's; keep it out of the repository.
example/public/audio/*.mp3
example/public/audio/*.m4a
example/public/audio/*.wav

# Python bytecode from the example tools
__pycache__/
