{
  "name": "@tlawat/remotion-mushaf-line",
  "version": "0.4.0",
  "description": "Render lines of the KFGQPC V4 (1441H) mushaf in Remotion, exactly as printed, with @remotion/transitions entrances and exits.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tlawat/remotion-mushaf-line-renderer.git",
    "directory": "packages/remotion-mushaf-line-renderer"
  },
  "homepage": "https://github.com/tlawat/remotion-mushaf-line-renderer#readme",
  "bugs": "https://github.com/tlawat/remotion-mushaf-line-renderer/issues",
  "keywords": [
    "remotion",
    "quran",
    "mushaf",
    "qul",
    "kfgqpc",
    "tajweed",
    "arabic",
    "video"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsup",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "tsc --noEmit -p tsconfig.test-types.json",
    "test:browser": "playwright test -c test/browser/playwright.config.mts",
    "test:render": "vitest run --project render --root ../..",
    "prepublishOnly": "bun run build && bun run check:package"
  },
  "peerDependencies": {
    "@remotion/transitions": ">=4.0.374",
    "@tlawat/mushaf-fonts-qpc-v4": "^1.20260912.0",
    "@tlawat/mushaf-fonts-qpc-v4-tajweed": "^1.20260912.0",
    "react": ">=18.0.0",
    "remotion": ">=4.0.374"
  },
  "peerDependenciesMeta": {
    "@tlawat/mushaf-fonts-qpc-v4": {
      "optional": true
    },
    "@tlawat/mushaf-fonts-qpc-v4-tajweed": {
      "optional": true
    }
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.521",
    "@remotion/player": "4.0.521",
    "@remotion/renderer": "4.0.521",
    "@remotion/transitions": "4.0.521",
    "remotion": "4.0.521"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
