{
  "name": "remotion-mushaf-line-renderer-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo for remotion-mushaf-line-renderer: render printed lines of the KFGQPC V4 mushaf in Remotion.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun run --cwd example dev",
    "build": "bun run --cwd packages/remotion-mushaf-line-renderer build",
    "check": "biome ci .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project scripts --project unit",
    "test:watch": "vitest --project scripts --project unit",
    "test:types": "bun run --cwd packages/remotion-mushaf-line-renderer test:types",
    "test:browser": "bun run --cwd packages/remotion-mushaf-line-renderer test:browser",
    "test:render": "vitest run --project render",
    "typecheck": "bun run --cwd packages/remotion-mushaf-line-renderer typecheck && bun run --cwd example typecheck",
    "check:package": "bun run --cwd packages/remotion-mushaf-line-renderer check:package",
    "qul": "node scripts/qul.mjs",
    "fonts": "node scripts/qul.mjs fonts 1,10,187,604",
    "verify:cdn": "node scripts/qul.mjs verify",
    "fonts-packages": "node scripts/fonts-package.mjs",
    "fonts-packages:fill": "node scripts/fonts-package.mjs fill all --cdn",
    "check:fonts-packages": "node scripts/fonts-package.mjs check all"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^27.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
