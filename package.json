{
  "name": "remotion-mushaf-line-renderer-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo for remotion-mushaf-line-renderer: render one line of the KFGQPC V4 mushaf in Remotion.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter remotion-mushaf-line-renderer build",
    "check:package": "pnpm --filter remotion-mushaf-line-renderer check:package",
    "test": "vitest run --project scripts --project unit",
    "test:watch": "vitest --project scripts --project unit",
    "test:types": "pnpm --filter remotion-mushaf-line-renderer test:types",
    "test:browser": "pnpm --filter remotion-mushaf-line-renderer test:browser",
    "test:render": "pnpm --filter remotion-mushaf-line-renderer test:render",
    "typecheck": "pnpm -r --if-present typecheck",
    "fetch-data": "node scripts/fetch-qul.mjs",
    "verify:cdn": "node scripts/verify-cdn.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^27.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
